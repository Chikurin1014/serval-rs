# `nix build` result
/result

# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# direnv
.envrc
.direnv/

# Vim / Neovim settings
.nvim.lua
.nvimrc
.exrc

# Python (end-to-end tests)
__pycache__/
.pytest_cache/

# wrangler (Cloudflare Pages deploys) cache
/.wrangler

# The documents, built (`mdbook build docs`, and into the web app's), and their
# videos and screenshots (`docs/media/capture.py`)
/docs/book
/packages/web/public/docs
/docs/src/media

# The plugins' API reference, generated (`nix build .#docs-api -o docs/src/api`)
/docs/src/api

# The third-party licenses, as they are copied into the web app's
/packages/web/public/third-party-licenses.html
