__pycache__/
.pytest_cache/

# wrangler (Cloudflare Pages deploys) cache
/.wrangler

# The documents, built (`mdbook build docs`, and into the web app's), and their
# videos and screenshots (`docs/media/capture.py`)
/docs/book
/packages/web/public/docs
/docs/src/media

# The web app and the serial bridge, built, in the VS Code extension; the
# license copied in, and its packages
/packages/vscode/media
/packages/vscode/bin
/packages/vscode/LICENSE
/packages/vscode/*.vsix

# The plugins' API reference, generated (`nix build .#docs-api -o docs/src/api`)
/docs/src/api

# The dioxus components' theme, which `dx components add` writes: not linked,
# as `packages/ui/assets/styling/theme.css` has all of it
/packages/ui/assets/dx-components-theme.css
